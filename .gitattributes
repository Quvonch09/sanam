# Handle line endings automatically
* text=auto

# Force LF for these file types (important for Netlify/Linux servers)
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.html  text eol=lf

# Binary files — do not touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   binary
*.woff  binary
*.woff2 binary
